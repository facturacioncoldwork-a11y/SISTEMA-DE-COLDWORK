# Cabeceras de Cloudflare para la app.
# Los .js y .css llevan un hash en el nombre: si cambian, cambia el nombre. Se guardan un a?o
# en el navegador y la segunda visita no los vuelve a descargar.
/*.js
  Cache-Control: public, max-age=31536000, immutable
/*.css
  Cache-Control: public, max-age=31536000, immutable

# La pagina y la configuracion siempre frescas (para que una nueva version llegue al instante).
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/config.json
  Cache-Control: no-store

# Seguridad basica para todas las respuestas
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(self), geolocation=(self), microphone=()
